{
  "name": "prof-profiler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "db:init": "npx tsx -r dotenv/config src/lib/db/init.ts",
    "db:migrate": "npx tsx -r dotenv/config src/lib/db/migrate.ts",
    "db:seed": "npx tsx -r dotenv/config src/lib/db/seed.ts",
    "purge-data": "node notenv.config()scripts/purge-expired-data.mjs",
    "generate-keys": "node -e \"console.log('ENCRYPTION_KEY=' + require('crypto').randomBytes(32).toString('hex')); console.log('JWT_SECRET=' + require('crypto').randomBytes(32).toString('hex'));\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.936.0",
    "@aws-sdk/s3-presigned-post": "^3.936.0",
    "@aws-sdk/s3-request-presigner": "^3.936.0",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@types/pg": "^8.15.6",
    "axios": "^1.13.1",
    "framer-motion": "^12.23.24",
    "next": "16.0.1",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.9"
  }
}
